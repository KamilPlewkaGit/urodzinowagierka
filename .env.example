# Neon PostgreSQL connection string. Keep this server-only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-32-byte-or-longer-random-secret"

# Generate with: node -e "require('bcryptjs').hash('choose-a-strong-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$replace.with.a.real.bcrypt.hash"
